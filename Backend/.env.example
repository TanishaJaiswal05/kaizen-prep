# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/kaizen-prep

# Auth — use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-me

# Google Gemini
GOOGLE_GENAI_API_KEY=replace-me
GEMINI_MODEL=gemini-3-flash-preview

# Demo account created by `npm run seed:demo` (defaults shown)
# DEMO_EMAIL=demo@gmail.com
# DEMO_PASSWORD=demo12345
# DEMO_USERNAME=demo
